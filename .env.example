# ====================================================================
# MINHAS FINANÇAS - TEMPLATE DE VARIÁVEIS DE AMBIENTE (VERCEL & LOCAL)
# ====================================================================

# Supabase Credentials (Obrigatórias)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-key-aqui

# Chaves Públicas para Nuxt 3 (Compatibilidade adicional do @nuxtjs/supabase)
NUXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sua-chave-anon-key-aqui

# Supabase Service Role Key (Apenas para Edge Functions / Cron Jobs autônomos)
# ATENÇÃO: NUNCA exponha esta chave no frontend público!
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Configuração do Ambiente
NODE_ENV=production
